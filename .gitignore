# зависимости
/node_modules

# сборка и покрытие
/coverage
/dist
/build

# локальное состояние — плеер пишет его при остановке
*.json.tmp

# редакторы и ОС
.idea
.vscode
.DS_Store
*.pem

# логи
*.log
**/*.trace

# мусор загрузки: всё до проверки живёт в storage/tmp и не должно утекать
*.part
*.upload
*.progress

# база. mp3/wav/opus наружу не отдаём: storage/ игнорируется целиком,
# эти правила — страховка, если файл окажется за пределами storage
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
__pycache__/
*.pyc

# пакетные менеджеры: проект на bun, bun.lock — единственный источник правды
package-lock.json
pnpm-lock.yaml
yarn.lock

# mise ставит свои файлы рядом с конфигом проекта
.mise.local.toml
.mise.*.local.toml