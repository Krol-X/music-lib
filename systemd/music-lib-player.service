[Unit]
Description=MusicLib player — MPRIS-мост над библиотекой (mpv на session bus)
# Мост виден пультам только с graphical-session и не нужен до неё.
PartOf=graphical-session.target
After=graphical-session.target music-lib.service
# Только упорядочивание, не зависимость по жизни: рестарт сервера не тревожит плеер.

[Service]
ExecStart=%h/.bun/bin/bun %h/Work/music-lib-v0/player/bridge.mjs
# Хост/порт дефолтные у бриджа (127.0.0.1:3000), переопределять не требуется.
Restart=on-failure
RestartSec=2
# KillMode по умолчанию весь cgroup: systemd гасит и mpv-потомка —
# звук не остаётся висеть рядом с умершим мостом.
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
